# Production environment for deploy/compose.yml — copy to deploy/.env and fill in.
# Everything the containers need comes from here; there is no .env inside the image. Values the
# compose file fixes (DB_HOST, REDIS_HOST, the drivers, BROADCAST_CONNECTION) are not repeated.
#
# Secrets: generate with `openssl rand -base64 32` (APP_KEY needs the `base64:` prefix).

# ---- hostnames (Caddy obtains certificates for both; DNS must point here first) ----
SITE_HOST=handyman.cm
APP_HOST=app.handyman.cm
ACME_EMAIL=you@handyman.cm

# ---- app ----
APP_NAME=HandyMan
APP_KEY=base64:CHANGE_ME
APP_URL=https://handyman.cm
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Douala
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---- database (the postgres service; the volume keeps it) ----
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=handyman
DB_USERNAME=handyman
DB_PASSWORD=CHANGE_ME

# ---- redis (cache, sessions, queue) ----
REDIS_CLIENT=predis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ---- realtime (Reverb) — the key is PUBLIC and must match the app's environment.prod.ts ----
REVERB_APP_ID=handyman
REVERB_APP_KEY=bwnksdabq0wufulekwsw
REVERB_APP_SECRET=CHANGE_ME

# ---- API gates ----
# Raise this to retire builds below it (P0-08): every request from an older app gets 426 and the
# app stops on its "Update required" screen.
API_MIN_APP_VERSION=1.0.0
API_IDEMPOTENCY_REQUIRED=true

# ---- money (doc 03). `fake` until the aggregator account is live; then `cinetpay`. ----
PAYMENTS_GATEWAY=fake
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com
CINETPAY_NOTIFY_URL=https://handyman.cm/api/v1/webhooks/payments/cinetpay
CINETPAY_RETURN_URL=https://app.handyman.cm/

# ---- notifications (doc 07). `log` writes to the container log until the real senders exist:
#      push → `fcm` once the Firebase project is set; WhatsApp → `meta` once the generic
#      `handyman_follow_up` template (doc 07, "The WhatsApp template") is approved in fr + en;
#      SMS → `twilio` with the three values below — and OTP_SENDER=sms, or nobody can sign in. ----
PUSH_SENDER=fake
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
WHATSAPP_SENDER=log
# Meta Cloud API: a System User token with whatsapp_business_messaging + the business phone
# number's ID (Business portfolio → WhatsApp → API setup).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=handyman_follow_up
SMS_SENDER=log
# Twilio Programmable Messaging: the Account SID + Auth Token from the console, and the sender —
# a purchased number in E.164, the alphanumeric id "HandyMan" (works for Cameroon, no replies), or
# a Messaging Service SID (MG…). Both MTN and Orange numbers are reachable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=HandyMan
# The sign-in code rides the SMS rail. `log` here means NO ONE can sign in to this build.
OTP_SENDER=sms
# Where every nudge's link lands: the APP host (not the site), which answers `/follow-up/{id}`.
# This is also the URL approved on the WhatsApp template's button — change it, re-submit.
FOLLOW_UP_LINK_BASE=https://app.handyman.cm/follow-up

# ---- marketplace flags (P8-03/04): off until supply supports them ----
MARKETPLACE_DISPATCH_ENABLED=false
MARKETPLACE_BIDDING_ENABLED=false

# ---- staff who may open the Horizon dashboard (comma-separated emails) ----
HORIZON_DASHBOARD_EMAILS=you@handyman.cm

# ---- files. Local disk on the storage volume for v1; the verification-document disk is separate
#      by design (doc 04) and can move to an in-country object store without touching the rest. ----
FILESYSTEM_DISK=local
VERIFICATION_DISK_DRIVER=local

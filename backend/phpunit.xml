<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pinned, because the SEO tests assert absolute URLs (canonical, hreflang, the robots.txt
             Sitemap line) built from APP_URL. Dev runs the API on :8100 (and the app on :4200), so
             .env legitimately carries a port that these assertions do not expect. Pinning here keeps
             the suite independent of the local .env instead of forcing dev onto a port it does not
             use. -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_LOCALE" value="fr"/>
        <env name="APP_FALLBACK_LOCALE" value="fr"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="handyman_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <!-- Pinned to the PRODUCTION defaults, because the OTP limits are a security control and
             the suite must test the shipped numbers. Local `.env` raises them to a thousand so a
             morning of clicking through the app is not spent locked out — which silently turned
             "rejects the 4th OTP request" into a test of the developer's own env file, and it
             stopped failing when it should have. -->
        <env name="OTP_MAX_PER_PHONE_PER_HOUR" value="3"/>
        <env name="OTP_MAX_PER_IP_PER_HOUR" value="10"/>
        <env name="OTP_MAX_PER_DEVICE_PER_HOUR" value="5"/>
        <env name="OTP_MAX_VERIFY_ATTEMPTS" value="5"/>
        <env name="OTP_TTL_MINUTES" value="5"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
